{
  "manifest_version": 3,
  "name": "Character Utils",
  "version": "0.1.0",
  "description": "Override the text encoding of a page and convert the text in input fields",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "declarativeNetRequestWithHostAccess", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
